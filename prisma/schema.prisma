// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model User {
user_id String @id @default(cuid())
name  String 
password String?
Email String @unique
address  Address?
role Role? @relation(fields: [roleId],references:[role_id])
roleId String
channel Channel[]
order  Order[]
chatmessage ChatMessage[]
attachemant Attachemant[]
isActive Boolean @default(true)
createAt DateTime @default(now())
updateAt DateTime @updatedAt()
}

model Operater {
operater_id String @id @default(cuid())
name  String 
password String 
Email String @unique
role Role? @relation(fields: [roleId],references:[role_id])
roleId String
isActive Boolean @default(true)
createAt DateTime @default(now())
updateAt DateTime @updatedAt()
}

model Address{
  address_id String @id @default(cuid())
  door_no String 
  area String 
  street String 
  state String 
  aadhar_card Attachemant[]
  // aadher_card_front_id String @unique
  // aadher_card_back_id String @unique
  // aadher_card_front Attachemant? @relation(name:"aadher_card_front", fields: [aadher_card_front_id],references: [attachemant_id])
  // addher_card_back Attachemant? @relation(name:"addher_card_back", fields:[aadher_card_back_id],references: [attachemant_id])
  user User @relation(fields: [userId],references:[user_id])
  userId String @unique
  isActive Boolean @default(true)
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
}

model Role{
  role_id String @id @default(cuid())
  role_name String @unique
  user  User[]
  permission Permission[]
  operater Operater[]
  isActive Boolean @default(true)
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
}

model Permission{
   identifier  String   @id @unique
  description String?
  roles       Role[]
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Channel {
  channel_id String @id @default(cuid())
  name String @unique
  amount String
  logo_path String?
  user User[]
  order Order[]
  isActive Boolean @default(true)
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt()
}

model Order{
  order_id String @id @default(cuid())
  payed_amounts String?
  razorpayer_order_id String ?
  razorpay_payment_id String? 
  status OrderStatus @default(PENDING)
  userID String 
  user User @relation(fields: [userID],references:[user_id])
 // channelID String
  channel Channel[]
  isActive Boolean @default(true)
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt()
}

model Attachemant{
  attachemant_id String @id @default(cuid())
  url   String
  mime String 
  address_ID String
  address Address @relation(fields:[address_ID],references:[address_id])
  // front_aadhar Address? @relation(name:"aadher_card_front")
  // back_addher  Address? @relation(name:"addher_card_back")
  create_by User? @relation(fields: [create_user_id],references: [user_id])
  create_user_id String?
  isActive Boolean @default(true)
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt()
}


model ChatMessage{
  chat_id String @id @default(cuid())
 // role AIROLE
 role String
  content String 
  user User @relation(fields:[userID],references: [user_id])
  userID String 
  isActive  Boolean  @default(true)
  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model FaqChunk {
  id        String   @id @default(cuid())
  content   String
  embedding Float[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
   updateAt  DateTime @updatedAt
}


enum OrderStatus{
   PENDING
  SUCCESS
  FAILED
}

enum AIROLE{
  user
  assistant
}